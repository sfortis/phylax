<?xml version="1.0" encoding="utf-8"?>
<!-- Darkens the bottom of a widget image so the caption stays readable on any frame. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="90" android:startColor="#E6000000" android:centerColor="#80000000" android:endColor="#00000000" />
    <!-- Rounded like widget_background, because Android 10 and 11 ignore clipToOutline. -->
    <corners android:bottomLeftRadius="16dp" android:bottomRightRadius="16dp" />
</shape>

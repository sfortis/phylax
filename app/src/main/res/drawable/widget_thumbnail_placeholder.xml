<?xml version="1.0" encoding="utf-8"?>
<!-- A recent event without a picture: a 16:9 rounded frame with the camera icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="96dp" android:height="54dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_secondary_container" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:width="22dp" android:height="22dp" android:gravity="center"
        android:drawable="@drawable/widget_ic_camera" />
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- A camera of the camera alerts widget whose notifications are muted. The
     state has its own layout, so the colors come from resources and follow the
     wallpaper and dark mode. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_margin="3dp"
    android:background="@drawable/widget_item_muted_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="8dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_ic_alerts_off" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_item_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="1"
            android:maxLines="1"
            android:textColor="@color/widget_error"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>

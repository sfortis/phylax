<?xml version="1.0" encoding="utf-8"?>
<!-- A camera of the camera alerts widget whose notifications are on. A muted
     camera uses widget_alert_item_muted. The icon sits beside the text, so the
     name still fits when two rows share a two cell high widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_margin="3dp"
    android:background="@drawable/widget_alert_on_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="8dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_ic_alerts_on" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_on_primary_container"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_item_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.8"
            android:maxLines="1"
            android:textColor="@color/widget_on_primary_container"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
